# ========================================
# Compiler Selection
# ========================================

COMPILER ?= clang

ifeq ($(COMPILER),mingw)
	CC  = gcc
	CXX = g++
else ifeq ($(COMPILER),clang)
	CC  = clang
	CXX = clang++
else
	$(error Unknown compiler "$(COMPILER)". Use clang or mingw)
endif

# ========================================
# Output
# ========================================

OUT = bin/castlemania.exe

# ========================================
# Paths
# ========================================

INCLUDES = -I./include -I./src
LIBS = -L./libs

# ========================================
# Sources
# ========================================

C_SRC := $(shell powershell -Command "Get-ChildItem -Recurse src -Include *.c | %% { $$_.FullName }")
CPP_SRC := $(shell powershell -Command "Get-ChildItem -Recurse src -Include *.cpp | %% { $$_.FullName }")

# ========================================
# Objects
# ========================================

C_OBJ := $(C_SRC:.c=.o)
CPP_OBJ := $(CPP_SRC:.cpp=.o)

# ========================================
# Build
# ========================================

all: $(OUT)

$(OUT): $(C_OBJ) $(CPP_OBJ)
	$(CXX) -g $(C_OBJ) $(CPP_OBJ) $(LIBS) -o $(OUT)

%.o: %.c
	$(CC) -c -g $(INCLUDES) $< -o $@

%.o: %.cpp
	$(CXX) -c -g $(INCLUDES) $< -o $@

# ========================================
# Utilities
# ========================================

clean:
	del /S *.o 2>nul
	del $(OUT) 2>nul

info:
	@echo Compiler: $(COMPILER)
	@echo CC = $(CC)
	@echo CXX = $(CXX)