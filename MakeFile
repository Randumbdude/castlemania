CC := clang
CXX := clang++
NVCC := nvcc -ccbin "D:\Program Files\VisualStudio\VC\Tools\MSVC\14.51.36231\bin\Hostx64\x64"

INCLUDES := \
	-I./include \
	-I./libs/matrices/inc

SOURCE_DIRS := \
	src, \
	libs/matrices/src 

CCFLAGS := -g $(INCLUDES)
CXXFLAGS := -g $(INCLUDES)
NVCCFLAGS := -Xcompiler "/W3" -g $(INCLUDES)

TARGET := bin/castlemania.exe

C_SOURCES := $(shell powershell -NoProfile -Command "Get-ChildItem $(SOURCE_DIRS) -Recurse -Filter *.c | ForEach-Object { $$_.FullName }")
CPP_SOURCES := $(shell powershell -NoProfile -Command "Get-ChildItem $(SOURCE_DIRS) -Recurse -Filter *.cpp | ForEach-Object { $$_.FullName }")
CU_SOURCES := $(shell powershell -NoProfile -Command "Get-ChildItem $(SOURCE_DIRS) -Recurse -Filter *.cu | ForEach-Object { $$_.FullName }")

C_OBJECTS := $(C_SOURCES:.c=.obj)
CPP_OBJECTS := $(CPP_SOURCES:.cpp=.obj)
CU_OBJECTS := $(CU_SOURCES:.cu=.obj)

OBJECTS := $(C_OBJECTS) $(CPP_OBJECTS) $(CU_OBJECTS)

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(NVCC) $(OBJECTS) -o $@ 

%.obj: %.c
	$(CC) $(CCFLAGS) -c $< -o $@

%.obj: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

%.obj: %.cu
	$(NVCC) $(NVCCFLAGS) -c $< -o $@

clean:
	del /S /Q *.obj 2>nul
	del /Q $(TARGET) 2>nul

.PHONY: all clean