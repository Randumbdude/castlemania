CC  := clang
CXX := clang++

INCLUDES := \
	-I./include \
	-I./libs

CFLAGS   := -g $(INCLUDES)
CXXFLAGS := -g $(INCLUDES)

TARGET := bin/castlemania.exe

C_SOURCES := $(shell powershell -NoProfile -Command "Get-ChildItem src -Recurse -Filter *.c | %% { $$_.FullName }")
CPP_SOURCES := $(shell powershell -NoProfile -Command "Get-ChildItem src -Recurse -Filter *.cpp | %% { $$_.FullName }")

C_OBJECTS := $(C_SOURCES:.c=.o)
CPP_OBJECTS := $(CPP_SOURCES:.cpp=.o)

OBJECTS := $(C_OBJECTS) $(CPP_OBJECTS)

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CXX) $(OBJECTS) -o $@

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	del /S /Q *.o 2>nul
	del /Q $(TARGET) 2>nul

.PHONY: all clean