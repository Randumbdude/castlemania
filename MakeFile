CXX := clang++
NVCC := nvcc -ccbin "D:\Program Files\VisualStudio\VC\Tools\MSVC\14.51.36231\bin\Hostx64\x64"

INCLUDES := \
	-I./include \
	-I./libs/log_dump/inc \
	-I./libs/matrices/inc \
	-I./libs/hot_loader/inc

CXXFLAGS := -std=c++26 -g $(INCLUDES)
NVCCFLAGS := -g $(INCLUDES)

TARGET := "bin/mksr.exe"

EXCLUDE_REGEX := $(shell powershell -NoProfile -Command "(Get-Content make_excludes) -join '|'")

CPP_SOURCES := $(shell powershell -NoProfile -Command "Get-ChildItem . -Recurse -Filter *.cpp | Where-Object { $$_.FullName -notmatch '$(EXCLUDE_REGEX)' } | ForEach-Object { $$_.FullName }")

CU_SOURCES := $(shell powershell -NoProfile -Command "Get-ChildItem . -Recurse -Filter *.cu | Where-Object { $$_.FullName -notmatch '$(EXCLUDE_REGEX)' } | ForEach-Object { $$_.FullName }")

CPP_OBJECTS := $(CPP_SOURCES:.cpp=.obj)
CU_OBJECTS := $(CU_SOURCES:.cu=.obj)

OBJECTS := $(CPP_OBJECTS) $(CU_OBJECTS)

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(NVCC) -o $@ $(OBJECTS)

%.obj: %.cpp
	$(CXX) $(CXXFLAGS) -c "$<" -o "$@"

%.obj: %.cu
	$(NVCC) $(NVCCFLAGS) -c "$<" -o "$@"

clean:
	del /S /Q *.obj 2>nul
	del /Q $(TARGET) 2>nul

.PHONY: all clean