{
  "version": "2.0.0",
  "tasks": [
{
  "label": "move-o-files-to-bin",
  "type": "shell",
  "command": "powershell",
  "args": [
    "-Command",
    "if (!(Test-Path bin)) { New-Item -ItemType Directory bin | Out-Null }; Get-ChildItem -Recurse -Filter *.o | ForEach-Object { Move-Item $_.FullName bin -Force }"
  ],
  "problemMatcher": []
},
    {
      "label": "build-project (mingw)",
      "type": "shell",
      "command": "D:/apps/make/bin/make.exe COMPILER=mingw",
      "problemMatcher": []
    },
    {
      "label": "build-project (clang)",
      "type": "shell",
      "command": "D:/apps/make/bin/make.exe COMPILER=clang",
      "problemMatcher": []
    },
    {
      "label": "build-and-collect (mingw)",
      "dependsOn": [
        "build-project (mingw)",
        "move-o-files-to-bin"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-and-collect (clang)",
      "dependsOn": [
        "build-project (clang)",
        "move-o-files-to-bin"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}